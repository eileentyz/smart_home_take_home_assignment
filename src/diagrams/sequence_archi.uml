@startuml
title NTU Dorm Smart Lighting — Sequence Diagram

participant "System Timer\n(every 10s)" as Time
participant "LightingController\nROS 2 Node" as ROS
participant "Mosquitto\nMQTT Broker" as MQTT
participant "Zigbee2MQTT" as Z2M
participant "SONOFF Zigbee\nSmart Plug" as Plug
participant "Lamp / Light" as Lamp
participant "ROS 2 Topic\n/light_state" as Topic

== Node Startup (__init__) ==

ROS -> MQTT : connect(localhost, 1883, keepalive=60)
activate MQTT
MQTT --> ROS : on_mqtt_connect(rc=0)
deactivate MQTT

ROS -> MQTT : subscribe(zigbee2mqtt/0xa4c1380fccb9ffff)
note right of ROS
  mqtt_client.loop_start()
  MQTT runs in background thread
  ROS 2 timer created: every 10.0s
  → check_schedule()
end note

ROS -> ROS : log "Smart lighting controller started."

== Schedule Check Loop (every 10 seconds) ==

loop Every 10 seconds

    Time -> ROS : check_schedule()
    activate ROS
    ROS -> ROS : now = datetime.now()\ncurrent_time = HH:MM

    alt last_command_time == current_time

        ROS -> ROS : return (already acted\nthis minute — skip)

    else current_time == "20:00"

        ROS -> ROS : send_light_command("ON")\nlast_command_time = "20:00"
        ROS -> MQTT : publish(\n  topic: zigbee2mqtt/0xa4c1380fccb9ffff/set\n  payload: {"state": "ON"}\n)
        activate MQTT
        MQTT -> Z2M : forward MQTT message
        deactivate MQTT
        activate Z2M
        Z2M -> Plug : Zigbee ON command
        deactivate Z2M
        activate Plug
        Plug -> Lamp : switch power ON
        activate Lamp

    else current_time == "08:00"

        ROS -> ROS : send_light_command("OFF")\nlast_command_time = "08:00"
        ROS -> MQTT : publish(\n  topic: zigbee2mqtt/0xa4c1380fccb9ffff/set\n  payload: {"state": "OFF"}\n)
        activate MQTT
        MQTT -> Z2M : forward MQTT message
        deactivate MQTT
        activate Z2M
        Z2M -> Plug : Zigbee OFF command
        deactivate Z2M
        activate Plug
        Plug -> Lamp : switch power OFF
        deactivate Lamp

    else Any other time

        ROS -> ROS : no command sent

    end

    deactivate ROS

end

== State Feedback (MQTT background thread) ==

Plug -> Z2M : report state JSON
deactivate Plug
activate Z2M
Z2M -> MQTT : publish(\n  topic: zigbee2mqtt/0xa4c1380fccb9ffff\n  payload: {"state": "ON/OFF", ...}\n)
deactivate Z2M

activate MQTT
MQTT -> ROS : on_mqtt_message(msg)
deactivate MQTT

activate ROS
ROS -> ROS : payload = msg.payload.decode()

alt JSON decode succeeds

    ROS -> ROS : data = json.loads(payload)\nlight_state = data.get("state", payload)

else JSONDecodeError

    ROS -> ROS : light_state = payload\n(raw string fallback)

end

ROS -> Topic : publish(std_msgs/String)\ndata = light_state ("ON" or "OFF")
ROS -> ROS : log "Received light state from MQTT: {light_state}"
deactivate ROS

== Node Shutdown (Ctrl+C / KeyboardInterrupt) ==

ROS -> ROS : mqtt_client.loop_stop()
ROS -> ROS : destroy_node()
ROS -> ROS : rclpy.shutdown()

@enduml